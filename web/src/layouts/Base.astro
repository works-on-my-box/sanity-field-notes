---
const { title } = Astro.props;
// Подпуть GitHub Pages (BASE_URL) без завершающего слэша.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Field notes</title>
    <style>
      :root { color-scheme: light dark; font: 16px/1.5 system-ui, sans-serif; }
      body { max-width: 760px; margin: 0 auto; padding: 24px 16px; }
      header a { text-decoration: none; font-weight: 600; }
      code { font-family: ui-monospace, monospace; font-size: 0.92em; padding: 0 3px; background: rgba(127,127,127,.15); border-radius: 3px; }
      .meta { color: #888; font-size: 0.9em; }
      .tag { display: inline-block; margin-right: 6px; font-size: 0.85em; }
      .superseded { border-left: 3px solid #c60; padding-left: 10px; }
      section h2 { font-size: 1.05em; margin-bottom: 4px; }
      li { margin-bottom: 6px; }
    </style>
  </head>
  <body>
    <header><a href={`${base}/`}>Field notes</a> <span class="meta">— symptom → cause → rule, from an unattended browser-automation stack</span></header>
    <main><slot /></main>
  </body>
</html>
